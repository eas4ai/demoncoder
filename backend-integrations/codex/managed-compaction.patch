+use super::*;
+use serde_json::json;
+
+fn expected() -> Acknowledgment {
+    Acknowledgment {
+        protocol: PROTOCOL.to_string(),
+        challenge: "fresh-challenge".to_string(),
+        hook_event_name: "PreCompact".to_string(),
+        session_id: "session-1".to_string(),
+        turn_id: "turn-1".to_string(),
+    }
+}
+
+#[test]
+fn acknowledgment_requires_explicit_fresh_typed_decision() {
+    for event in ["PreCompact", "PostCompact"] {
+        let mut expected = expected();
+        expected.hook_event_name = event.to_string();
+        let valid = json!({"continue": true, "demonCoderCompaction": expected});
+        assert_eq!(decode_ack(&valid.to_string(), &expected).unwrap(), None);
+        let mut invalid = vec![
+            "".to_string(),
+            "logged".to_string(),
+            "{".to_string(),
+            "null".to_string(),
+            "{}".to_string(),
+            r#"{"continue":true}"#.to_string(),
+        ];
+        for key in [
+            "protocol",
+            "challenge",
+            "hook_event_name",
+            "session_id",
+            "turn_id",
+        ] {
+            let mut stale = valid.clone();
+            stale["demonCoderCompaction"][key] = json!("different");
+            invalid.push(stale.to_string());
+        }
+        let mut extra = valid.clone();
+        extra["extra"] = json!(true);
+        invalid.push(extra.to_string());
+        let mut extra = valid.clone();
+        extra["demonCoderCompaction"]["extra"] = json!(true);
+        invalid.push(extra.to_string());
+        let mut wrong_type = valid.clone();
+        wrong_type["continue"] = json!("true");
+        invalid.push(wrong_type.to_string());
+        invalid.push(format!("{valid}\n{valid}"));
+        for output in invalid {
+            assert!(
+                decode_ack(&output, &expected).is_err(),
+                "accepted {output:?}"
+            );
+        }
+        let denied = json!({"continue": false, "stopReason":"policy denied", "demonCoderCompaction":expected});
+        assert_eq!(
+            decode_ack(&denied.to_string(), &expected).unwrap(),
+            Some("policy denied".to_string())
+        );
+    }
+}
+
+fn declaration() -> serde_json::Value {
+    let group = json!([{ "hooks": [{ "type": "command", "command": "relay", "timeout": 65 }] }]);
+    json!({ "hooks": {"PreCompact": group, "PostCompact": group} })
+}
+
+fn requirement(bytes: &[u8]) -> Requirement {
+    Requirement {
+        protocol: PROTOCOL.to_string(),
+        source_path: std::env::temp_dir().join("private-hooks.json"),
+        source_sha256: format!("{:x}", sha2::Sha256::digest(bytes)),
+        command: "relay".to_string(),
+    }
+}
+
+#[test]
+fn declaration_requires_hash_identity_and_both_synchronous_boundaries() {
+    let bytes = serde_json::to_vec(&declaration()).unwrap();
+    assert!(validate_declaration(&requirement(&bytes), &bytes).is_ok());
+    let mut req = requirement(&bytes);
+    req.source_sha256 = "0".repeat(64);
+    assert!(
+        validate_declaration(&req, &bytes).is_err(),
+        "accepted untrusted source hash"
+    );
+    let mut req = requirement(&bytes);
+    req.command = "substituted".to_string();
+    assert!(validate_declaration(&req, &bytes).is_err());
+    let mut req = requirement(&bytes);
+    req.source_path = PathBuf::from("relative.json");
+    assert!(validate_declaration(&req, &bytes).is_err());
+    let mut req = requirement(&bytes);
+    req.protocol = "other".to_string();
+    assert!(validate_declaration(&req, &bytes).is_err());
+    for event in ["PreCompact", "PostCompact"] {
+        for (field, value) in [
+            ("async", json!(true)),
+            ("command", json!("different")),
+            ("type", json!("mcp_tool")),
+            ("timeout", json!(0)),
+            ("timeout", json!(121)),
+            ("env", json!({})),
+            ("enabled", json!(false)),
+        ] {
+            let mut changed = declaration();
+            changed["hooks"][event][0]["hooks"][0][field] = value;
+            let bytes = serde_json::to_vec(&changed).unwrap();
+            assert!(
+                validate_declaration(&requirement(&bytes), &bytes).is_err(),
+                "accepted {changed}"
+            );
+        }
+        for groups in [
+            json!([]),
+            json!([{"hooks":[]}]),
+            json!([
+                declaration()["hooks"][event][0],
+                declaration()["hooks"][event][0]
+            ]),
+        ] {
+            let mut changed = declaration();
+            changed["hooks"][event] = groups;
+            let bytes = serde_json::to_vec(&changed).unwrap();
+            assert!(validate_declaration(&requirement(&bytes), &bytes).is_err());
+        }
+    }
+}
