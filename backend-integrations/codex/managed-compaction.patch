+use crate::engine::ConfiguredHandler;
+use crate::engine::ConfiguredHandlerKind;
+use anyhow::Context;
+use codex_protocol::protocol::HookEventName;
+use codex_protocol::protocol::HookSource;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use std::io::Read;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::OnceLock;
+
+pub(crate) const PROTOCOL: &str = "demoncoder-compaction-v1";
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Acknowledgment {
+    pub protocol: String,
+    pub challenge: String,
+    pub hook_event_name: String,
+    pub session_id: String,
+    pub turn_id: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Response {
+    #[serde(rename = "continue")]
+    proceed: bool,
+    #[serde(rename = "demonCoderCompaction")]
+    acknowledgment: Acknowledgment,
+    #[serde(rename = "stopReason")]
+    stop_reason: Option<String>,
+}
+
+fn decode_ack(stdout: &str, expected: &Acknowledgment) -> anyhow::Result<Option<String>> {
+    let response: Response = serde_json::from_str(stdout)?;
+    anyhow::ensure!(
+        response.acknowledgment == *expected,
+        "managed compaction acknowledgment does not match the pending operation"
+    );
+    Ok((!response.proceed).then(|| {
+        response
+            .stop_reason
+            .unwrap_or_else(|| "managed compaction relay denied continuation".to_string())
+    }))
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Requirement {
+    protocol: String,
+    source_path: PathBuf,
+    source_sha256: String,
+    command: String,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Declaration {
+    hooks: CompactEvents,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CompactEvents {
+    #[serde(rename = "PreCompact")]
+    pre: Vec<CompactGroup>,
+    #[serde(rename = "PostCompact")]
+    post: Vec<CompactGroup>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CompactGroup {
+    hooks: Vec<CompactCommand>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CompactCommand {
+    #[serde(rename = "type")]
+    kind: String,
+    command: String,
+    timeout: u64,
+    #[serde(default)]
+    r#async: bool,
+}
+
+fn validate_declaration(requirement: &Requirement, bytes: &[u8]) -> anyhow::Result<Declaration> {
+    anyhow::ensure!(
+        requirement.protocol == PROTOCOL,
+        "unsupported managed compaction protocol"
+    );
+    anyhow::ensure!(
+        requirement.source_path.is_absolute(),
+        "managed compaction source must be absolute"
+    );
+    anyhow::ensure!(
+        !requirement.command.trim().is_empty(),
+        "managed compaction command is empty"
+    );
+    anyhow::ensure!(
+        bytes.len() <= 1_048_576,
+        "managed compaction declaration is too large"
+    );
+    anyhow::ensure!(
+        format!("{:x}", sha2::Sha256::digest(bytes)) == requirement.source_sha256,
+        "untrusted managed compaction source hash"
+    );
+    let declaration: Declaration = serde_json::from_slice(bytes)?;
+    for groups in [&declaration.hooks.pre, &declaration.hooks.post] {
+        anyhow::ensure!(
+            groups.len() == 1 && groups[0].hooks.len() == 1,
+            "managed compaction requires exactly one handler per boundary"
+        );
+        let handler = &groups[0].hooks[0];
+        anyhow::ensure!(
+            handler.kind == "command" && handler.command == requirement.command && !handler.r#async,
+            "managed compaction requires the exact synchronous relay command"
+        );
+        anyhow::ensure!(
+            (1..=120).contains(&handler.timeout),
+            "managed compaction timeout must be 1..=120 seconds"
+        );
+    }
+    Ok(declaration)
+}
+
+const ENVIRONMENT_VARIABLE: &str = "CODEX_DEMONCODER_COMPACTION_RELAY";
+static STARTUP: OnceLock<Result<Option<Arc<ManagedCompaction>>, String>> = OnceLock::new();
+
+/// Capture the required relay before any backend session starts. Errors remain fail-closed.
+pub fn initialize_managed_compaction() -> anyhow::Result<()> {
+    STARTUP
+        .get_or_init(|| match std::env::var(ENVIRONMENT_VARIABLE) {
+            Ok(raw) => ManagedCompaction::load(&raw)
+                .map(Arc::new)
+                .map(Some)
+                .map_err(|error| error.to_string()),
+            Err(std::env::VarError::NotPresent) => Ok(None),
+            Err(error) => Err(format!("invalid managed compaction requirement: {error}")),
+        })
+        .as_ref()
+        .map(|_| ())
+        .map_err(|error| anyhow::anyhow!("{error}"))
+}
+
+/// Identifies this integration; production qualification must also verify the binary digest.
+pub fn managed_compaction_capability() -> &'static str {
+    r#"{"protocol":"demoncoder-compaction-v1","source_version":"0.153.4","patch_version":1}"#
+}
+
+pub(crate) fn startup_snapshot() -> anyhow::Result<Option<Arc<ManagedCompaction>>> {
+    STARTUP
+        .get()
+        .cloned()
+        .unwrap_or(Ok(None))
+        .map_err(anyhow::Error::msg)
+}
+
+#[derive(Debug)]
+pub(crate) struct ManagedCompaction {
+    pub(crate) pre: ConfiguredHandler,
+    pub(crate) post: ConfiguredHandler,
+}
+
+impl ManagedCompaction {
+    pub(crate) async fn run(
+        &self,
+        engine: &crate::engine::ClaudeHooksEngine,
+        handler: &ConfiguredHandler,
+        input: Result<String, serde_json::Error>,
+        cwd: &std::path::Path,
+        session_id: String,
+        turn_id: String,
+    ) -> crate::StatelessHookOutcome {
+        use crate::engine::dispatcher;
+        use codex_protocol::protocol::HookCompletedEvent;
+        use codex_protocol::protocol::HookOutputEntry;
+        use codex_protocol::protocol::HookOutputEntryKind;
+        use codex_protocol::protocol::HookRunStatus;
+        let expected = Acknowledgment {
+            protocol: PROTOCOL.to_string(),
+            challenge: uuid::Uuid::new_v4().to_string(),
+            hook_event_name: dispatcher::hook_event_name_label(handler.event_name).to_string(),
+            session_id,
+            turn_id: turn_id.clone(),
+        };
+        let input = input.and_then(|input| {
+            let mut input: serde_json::Value = serde_json::from_str(&input)?;
+            input["demonCoderCompaction"] =
+                serde_json::json!({"protocol":PROTOCOL, "challenge":expected.challenge});
+            serde_json::to_string(&input)
+        });
+        let result = match input {
+            Ok(input) => {
+                crate::engine::command_runner::run_managed_command(
+                    &engine.command_runtime,
+                    handler,
+                    &input,
+                    cwd,
+                )
+                .await
+            }
+            Err(error) => crate::engine::HandlerRunResult {
+                started_at: chrono::Utc::now().timestamp(),
+                completed_at: chrono::Utc::now().timestamp(),
+                duration_ms: 0,
+                exit_code: None,
+                stdout: String::new(),
+                stderr: String::new(),
+                error: Some(format!("serialize managed relay request: {error}")),
+            },
+        };
+        let decision = match &result.error {
+            Some(error) => Err(anyhow::anyhow!("{error}")),
+            None if result.exit_code != Some(0) => {
+                Err(anyhow::anyhow!("managed relay did not exit successfully"))
+            }
+            None => decode_ack(&result.stdout, &expected),
+        };
+        let (status, stop_reason) = match decision {
+            Ok(None) => (HookRunStatus::Completed, None),
+            Ok(Some(reason)) => (HookRunStatus::Stopped, Some(reason)),
+            Err(error) => (
+                HookRunStatus::Failed,
+                Some(format!(
+                    "{} required relay acknowledgment failed: {error}",
+                    expected.hook_event_name
+                )),
+            ),
+        };
+        let entries = stop_reason
+            .iter()
+            .map(|reason| HookOutputEntry {
+                kind: if status == HookRunStatus::Stopped {
+                    HookOutputEntryKind::Stop
+                } else {
+                    HookOutputEntryKind::Error
+                },
+                text: reason.clone(),
+            })
+            .collect();
+        crate::StatelessHookOutcome {
+            should_stop: stop_reason.is_some(),
+            stop_reason,
+            hook_events: vec![HookCompletedEvent {
+                turn_id: Some(turn_id),
+                run: dispatcher::completed_summary(handler, &result, status, entries),
+            }],
+        }
+    }
+
+    pub(crate) fn load(raw: &str) -> anyhow::Result<Self> {
+        anyhow::ensure!(
+            raw.len() <= 65_536,
+            "managed compaction requirement is too large"
+        );
+        let requirement: Requirement =
+            serde_json::from_str(raw).context("invalid managed compaction requirement")?;
+        anyhow::ensure!(
+            requirement.source_path.is_absolute(),
+            "managed compaction source must be absolute"
+        );
+        anyhow::ensure!(
+            std::fs::symlink_metadata(&requirement.source_path)
+                .context("inspect required managed compaction source")?
+                .file_type()
+                .is_file(),
+            "managed compaction source must be a regular file, not a symlink"
+        );
+        let mut options = std::fs::OpenOptions::new();
+        options.read(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            // A replacement FIFO must not block open; a replacement symlink must not be followed.
+            options.custom_flags(libc::O_NONBLOCK | libc::O_NOFOLLOW);
+        }
+        #[cfg(windows)]
+        {
+            use std::os::windows::fs::OpenOptionsExt;
+            const FILE_FLAG_OPEN_REPARSE_POINT: u32 = 0x0020_0000;
+            options.custom_flags(FILE_FLAG_OPEN_REPARSE_POINT);
+        }
+        let file = options
+            .open(&requirement.source_path)
+            .context("open required managed compaction source")?;
+        anyhow::ensure!(
+            file.metadata()
+                .context("inspect opened managed compaction source")?
+                .is_file(),
+            "opened managed compaction source is not a regular file"
+        );
+        let mut bytes = Vec::new();
+        file.take(1_048_577)
+            .read_to_end(&mut bytes)
+            .context("read required managed compaction source")?;
+        let declaration = validate_declaration(&requirement, &bytes)?;
+        let source_path = AbsolutePathBuf::try_from(requirement.source_path)?;
+        let mut handlers = [
+            (HookEventName::PreCompact, declaration.hooks.pre),
+            (HookEventName::PostCompact, declaration.hooks.post),
+        ]
+        .into_iter()
+        .enumerate()
+        .map(|(order, (event_name, groups))| {
+            let handler = groups
+                .into_iter()
+                .next()
+                .expect("validated group")
+                .hooks
+                .into_iter()
+                .next()
+                .expect("validated handler");
+            ConfiguredHandler {
+                builtin: false,
+                event_name,
+                matcher: None,
+                timeout_sec: handler.timeout,
+                status_message: None,
+                additional_context_limit: Default::default(),
+                source_path: source_path.clone().into(),
+                source: HookSource::SessionFlags,
+                display_order: order as i64,
+                kind: ConfiguredHandlerKind::Command {
+                    command: handler.command,
+                    env: Default::default(),
+                    r#async: false,
+                },
+            }
+        });
+        Ok(Self {
+            pre: handlers.next().expect("pre handler"),
+            post: handlers.next().expect("post handler"),
+        })
+    }
+}
