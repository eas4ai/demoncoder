+/// Managed relays have a total deadline and bounded output; ordinary hooks retain their runner.
+pub(crate) async fn run_managed_command(
+    runtime: &CommandHookRuntime,
+    handler: &ConfiguredHandler,
+    input_json: &str,
+    cwd: &Path,
+) -> HandlerRunResult {
+    use anyhow::Context;
+    let started_at = chrono::Utc::now().timestamp();
+    let started = Instant::now();
+    let exchange = async {
+        anyhow::ensure!(
+            input_json.len() <= 1_048_576,
+            "managed relay input exceeds limit"
+        );
+        let ConfiguredHandlerKind::Command {
+            command,
+            env,
+            r#async: false,
+        } = &handler.kind
+        else {
+            anyhow::bail!("managed relay must be a synchronous command");
+        };
+        anyhow::ensure!(
+            env.is_empty(),
+            "managed relay environment override is forbidden"
+        );
+        // The admitted command cannot be redirected through refreshed hooks.shell settings.
+        #[cfg(unix)]
+        let shell = CommandShell {
+            program: "/bin/sh".to_string(),
+            args: vec!["-c".to_string()],
+        };
+        #[cfg(not(unix))]
+        let shell = CommandShell {
+            program: "cmd.exe".to_string(),
+            args: vec!["/C".to_string()],
+        };
+        let mut command = build_command(&shell, command, &runtime.environment, env);
+        command
+            .current_dir(cwd)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .kill_on_drop(true);
+        #[cfg(unix)]
+        command.process_group(0);
+        #[cfg(windows)]
+        let job = JobObject::create().context("create managed relay process tree")?;
+        #[cfg(windows)]
+        let mut child = job
+            .spawn_contained(&mut command)
+            .context("spawn managed relay")?;
+        #[cfg(not(windows))]
+        let mut child = command.spawn().context("spawn managed relay")?;
+        // Unlike ordinary observer hooks, a managed relay cannot leave detached children.
+        let _tree = ProcessTreeGuard {
+            process_id: child.id(),
+            #[cfg(windows)]
+            job: Some(job),
+        };
+        let mut stdin = child
+            .stdin
+            .take()
+            .context("managed relay stdin unavailable")?;
+        let stdout = child
+            .stdout
+            .take()
+            .context("managed relay stdout unavailable")?;
+        let stderr = child
+            .stderr
+            .take()
+            .context("managed relay stderr unavailable")?;
+        let (_, stdout, stderr, status) = tokio::try_join!(
+            async {
+                stdin.write_all(input_json.as_bytes()).await?;
+                stdin.shutdown().await?;
+                drop(stdin);
+                Ok::<_, anyhow::Error>(())
+            },
+            read_managed_output(stdout),
+            read_managed_output(stderr),
+            async { Ok::<_, anyhow::Error>(child.wait().await?) },
+        )?;
+        Ok::<_, anyhow::Error>((status, stdout, stderr))
+    };
+    let completion = match timeout(Duration::from_secs(handler.timeout_sec), exchange).await {
+        Ok(Ok((status, stdout, stderr))) => CommandRunCompletion {
+            exit_code: status.code(),
+            stdout,
+            stderr,
+            error: None,
+            outcome: "completed",
+        },
+        result => CommandRunCompletion {
+            exit_code: None,
+            stdout: String::new(),
+            stderr: String::new(),
+            error: Some(match result {
+                Ok(Err(error)) => format!("managed relay exchange failed: {error}"),
+                Err(_) => "managed relay total deadline expired".to_string(),
+                Ok(Ok(_)) => unreachable!(),
+            }),
+            outcome: "managed_error",
+        },
+    };
+    finish_command_run(started_at, started, completion)
+}
+
+async fn read_managed_output(reader: impl tokio::io::AsyncRead + Unpin) -> anyhow::Result<String> {
+    use tokio::io::AsyncReadExt;
+    let mut bytes = Vec::new();
+    reader.take(65_537).read_to_end(&mut bytes).await?;
+    anyhow::ensure!(
+        bytes.len() <= 65_536,
+        "managed relay output exceeds 65536 bytes"
+    );
+    Ok(String::from_utf8(bytes)?)
+}
