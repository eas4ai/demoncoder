+#[test]
+fn decoder_matches_exact_managed_output_transport_boundary() {
+    let ack = expected("UserPromptSubmit");
+    let mut output = json!({"continue":true,"demonCoderOrdinary":ack,"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":""}});
+    let empty_size = output.to_string().len();
+    for size in [65_536, 65_537] {
+        output["hookSpecificOutput"]["additionalContext"] = json!("x".repeat(size - empty_size));
+        let wire = output.to_string();
+        assert_eq!(wire.len(), size);
+        let decoded = decode_response(&wire, &ack);
+        if size == 65_536 {
+            assert!(decoded.is_ok(), "exact transport limit rejected");
+        } else {
+            assert!(
+                decoded.is_err(),
+                "decoder accepted output larger than managed transport"
+            );
+        }
+    }
+}
