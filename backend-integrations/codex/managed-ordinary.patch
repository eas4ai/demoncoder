+        initialize_managed_ordinary().unwrap();
+        let later = startup_snapshot().unwrap().unwrap();
+        assert!(Arc::ptr_eq(&captured, &later));
+    } else {
+        assert!(first.is_err());
+        std::fs::write(
+            &requirement.source_path,
+            serde_json::to_vec(&declaration()).unwrap(),
+        )
+        .unwrap();
+        assert!(initialize_managed_ordinary().is_err());
+        assert!(startup_snapshot().is_err());
+    }
+}
