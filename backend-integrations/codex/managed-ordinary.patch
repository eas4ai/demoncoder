+use crate::engine::ConfiguredHandler;
+use crate::engine::ConfiguredHandlerKind;
+use crate::output_spill::AdditionalContextLimit;
+use anyhow::Context;
+use codex_protocol::protocol::HookEventName;
+use codex_protocol::protocol::HookSource;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use std::io::Read;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::OnceLock;
+
+pub(crate) const PROTOCOL: &str = "demoncoder-ordinary-v1";
+// Match read_managed_output: each captured stream is limited to 64 KiB.
+// The separate managed request input limit is 1 MiB. Host responses must fit 64 KiB.
+const MAX_OUTPUT_BYTES: usize = 65_536;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Acknowledgment {
+    protocol: String,
+    delivery_id: String,
+    hook_event_name: String,
+    session_id: String,
+    turn_id: String,
+}
+
+// Optional means absent, not an explicitly null or incorrectly typed value.
+fn present<'de, D, T>(deserializer: D) -> Result<Option<T>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+    T: Deserialize<'de>,
+{
+    T::deserialize(deserializer).map(Some)
+}
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct SubmitSpecific {
+    #[serde(rename = "hookEventName")]
+    event: String,
+    #[serde(
+        rename = "additionalContext",
+        default,
+        deserialize_with = "present",
+        skip_serializing_if = "Option::is_none"
+    )]
+    additional_context: Option<String>,
+}
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Response {
+    #[serde(rename = "continue")]
+    proceed: bool,
+    #[serde(rename = "demonCoderOrdinary", skip_serializing)]
+    acknowledgment: Acknowledgment,
+    #[serde(
+        rename = "stopReason",
+        default,
+        deserialize_with = "present",
+        skip_serializing_if = "Option::is_none"
+    )]
+    stop_reason: Option<String>,
+    #[serde(
+        default,
+        deserialize_with = "present",
+        skip_serializing_if = "Option::is_none"
+    )]
+    decision: Option<String>,
+    #[serde(
+        default,
+        deserialize_with = "present",
+        skip_serializing_if = "Option::is_none"
+    )]
+    reason: Option<String>,
+    #[serde(
+        rename = "hookSpecificOutput",
+        default,
+        deserialize_with = "present",
+        skip_serializing_if = "Option::is_none"
+    )]
+    specific: Option<SubmitSpecific>,
+}
+
+fn decode_response(stdout: &str, expected: &Acknowledgment) -> anyhow::Result<String> {
+    anyhow::ensure!(
+        stdout.len() <= MAX_OUTPUT_BYTES,
+        "managed ordinary response is too large"
+    );
+    let response: Response =
+        serde_json::from_str(stdout).context("invalid managed ordinary response")?;
+    anyhow::ensure!(
+        response.acknowledgment == *expected,
+        "managed ordinary acknowledgment does not match the pending delivery"
+    );
+    anyhow::ensure!(
+        matches!(
+            expected.hook_event_name.as_str(),
+            "UserPromptSubmit" | "Stop"
+        ),
+        "unsupported managed ordinary event"
+    );
+    if let Some(decision) = &response.decision {
+        anyhow::ensure!(decision == "block", "unsupported managed ordinary decision");
+        anyhow::ensure!(
+            response
+                .reason
+                .as_ref()
+                .is_some_and(|reason| !reason.trim().is_empty()),
+            "managed ordinary block requires a reason"
+        );
+    }
+    if let Some(specific) = &response.specific {
+        anyhow::ensure!(
+            expected.hook_event_name == "UserPromptSubmit" && specific.event == "UserPromptSubmit",
+            "managed ordinary event output does not match the delivery"
+        );
+    }
+    serde_json::to_string(&response).context("serialize managed ordinary event output")
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Requirement {
+    protocol: String,
+    source_path: PathBuf,
+    source_sha256: String,
+    submit_command: String,
+    stop_command: String,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Declaration {
+    hooks: OrdinaryEvents,
+}
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct OrdinaryEvents {
+    #[serde(rename = "UserPromptSubmit")]
+    submit: Vec<OrdinaryGroup>,
+    #[serde(rename = "Stop")]
+    stop: Vec<OrdinaryGroup>,
+}
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct OrdinaryGroup {
+    hooks: Vec<OrdinaryCommand>,
+}
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct OrdinaryCommand {
+    #[serde(rename = "type")]
+    kind: String,
+    command: String,
+    timeout: u64,
+    #[serde(default)]
+    r#async: bool,
+}
+
+fn validate_declaration(requirement: &Requirement, bytes: &[u8]) -> anyhow::Result<Declaration> {
+    anyhow::ensure!(
+        requirement.protocol == PROTOCOL,
+        "unsupported managed ordinary protocol"
+    );
+    anyhow::ensure!(
+        requirement.source_path.is_absolute(),
+        "managed ordinary source must be absolute"
+    );
+    anyhow::ensure!(
+        !requirement.submit_command.trim().is_empty()
+            && !requirement.stop_command.trim().is_empty(),
+        "managed ordinary command is empty"
+    );
+    anyhow::ensure!(
+        bytes.len() <= 1_048_576,
+        "managed ordinary declaration is too large"
+    );
+    anyhow::ensure!(
+        format!("{:x}", sha2::Sha256::digest(bytes)) == requirement.source_sha256,
+        "untrusted managed ordinary source hash"
+    );
+    let declaration: Declaration = serde_json::from_slice(bytes)?;
+    for (groups, command) in [
+        (&declaration.hooks.submit, &requirement.submit_command),
+        (&declaration.hooks.stop, &requirement.stop_command),
+    ] {
+        anyhow::ensure!(
+            groups.len() == 1 && groups[0].hooks.len() == 1,
+            "managed ordinary requires exactly one handler per boundary"
+        );
+        let handler = &groups[0].hooks[0];
+        anyhow::ensure!(
+            handler.kind == "command" && &handler.command == command && !handler.r#async,
+            "managed ordinary requires the exact synchronous relay command"
+        );
+        anyhow::ensure!(
+            (1..=120).contains(&handler.timeout),
+            "managed ordinary timeout must be 1..=120 seconds"
+        );
+    }
+    Ok(declaration)
+}
+
+const ENVIRONMENT_VARIABLE: &str = "CODEX_DEMONCODER_ORDINARY_RELAY";
+static STARTUP: OnceLock<Result<Option<Arc<ManagedOrdinary>>, String>> = OnceLock::new();
+
+/// Capture both required ordinary commands before any backend session starts.
+/// Requested-but-invalid declarations stay failed for the lifetime of the process.
+pub fn initialize_managed_ordinary() -> anyhow::Result<()> {
+    STARTUP
+        .get_or_init(|| match std::env::var(ENVIRONMENT_VARIABLE) {
+            Ok(raw) => ManagedOrdinary::load(&raw)
+                .map(Arc::new)
+                .map(Some)
+                .map_err(|error| error.to_string()),
+            Err(std::env::VarError::NotPresent) => Ok(None),
+            Err(error) => Err(format!("invalid managed ordinary requirement: {error}")),
+        })
+        .as_ref()
+        .map(|_| ())
+        .map_err(|error| anyhow::anyhow!("{error}"))
+}
+
+/// Identification only; qualification must bind the complete patch and binary digests.
+pub fn managed_ordinary_capability() -> &'static str {
+    r#"{"protocol":"demoncoder-ordinary-v1","source_version":"0.153.4","patch_version":1}"#
+}
+
+pub(crate) fn startup_snapshot() -> anyhow::Result<Option<Arc<ManagedOrdinary>>> {
+    STARTUP
+        .get()
+        .cloned()
+        .unwrap_or(Ok(None))
+        .map_err(anyhow::Error::msg)
+}
+
+#[derive(Debug)]
+pub(crate) struct ManagedOrdinary {
+    pub(crate) submit: ConfiguredHandler,
+    pub(crate) stop: ConfiguredHandler,
+}
+
+impl ManagedOrdinary {
+    pub(crate) async fn run_result(
+        &self,
+        engine: &crate::engine::ClaudeHooksEngine,
+        handler: &ConfiguredHandler,
+        input: Result<String, serde_json::Error>,
+        cwd: &std::path::Path,
+        session_id: String,
+        turn_id: String,
+    ) -> crate::engine::HandlerRunResult {
+        let expected = Acknowledgment {
+            protocol: PROTOCOL.to_string(),
+            // Transport correlation only. Native hook run IDs are intentionally unchanged.
+            delivery_id: uuid::Uuid::new_v4().to_string(),
+            hook_event_name: crate::engine::dispatcher::hook_event_name_label(handler.event_name)
+                .to_string(),
+            session_id,
+            turn_id,
+        };
+        let input = input.and_then(|input| {
+            let mut input: serde_json::Value = serde_json::from_str(&input)?;
+            input["demonCoderOrdinary"] = serde_json::to_value(&expected)?;
+            serde_json::to_string(&input)
+        });
+        let mut result = match input {
+            Ok(input) => {
+                crate::engine::command_runner::run_managed_command(
+                    &engine.command_runtime,
+                    handler,
+                    &input,
+                    cwd,
+                )
+                .await
+            }
+            Err(error) => crate::engine::HandlerRunResult {
+                started_at: chrono::Utc::now().timestamp(),
+                completed_at: chrono::Utc::now().timestamp(),
+                duration_ms: 0,
+                exit_code: None,
+                stdout: String::new(),
+                stderr: String::new(),
+                error: Some(format!("serialize managed ordinary request: {error}")),
+            },
+        };
+        if result.error.is_none() {
+            let decoded = if result.exit_code == Some(0) {
+                decode_response(&result.stdout, &expected)
+            } else {
+                Err(anyhow::anyhow!(
+                    "managed ordinary relay did not exit successfully"
+                ))
+            };
+            match decoded {
+                Ok(stdout) => result.stdout = stdout,
+                Err(error) => {
+                    result.error = Some(format!(
+                        "required managed ordinary acknowledgment failed: {error}"
+                    ))
+                }
+            }
+        }
+        result
+    }
+
+    pub(crate) fn load(raw: &str) -> anyhow::Result<Self> {
+        anyhow::ensure!(
+            raw.len() <= 65_536,
+            "managed ordinary requirement is too large"
+        );
+        let requirement: Requirement =
+            serde_json::from_str(raw).context("invalid managed ordinary requirement")?;
+        anyhow::ensure!(
+            requirement.source_path.is_absolute(),
+            "managed ordinary source must be absolute"
+        );
+        anyhow::ensure!(
+            std::fs::symlink_metadata(&requirement.source_path)
+                .context("inspect required managed ordinary source")?
+                .file_type()
+                .is_file(),
+            "managed ordinary source must be a regular file, not a symlink"
+        );
+        let mut options = std::fs::OpenOptions::new();
+        options.read(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            // A replacement FIFO must not block open; a replacement symlink must not be followed.
+            options.custom_flags(libc::O_NONBLOCK | libc::O_NOFOLLOW);
+        }
+        #[cfg(windows)]
+        {
+            use std::os::windows::fs::OpenOptionsExt;
+            const FILE_FLAG_OPEN_REPARSE_POINT: u32 = 0x0020_0000;
+            options.custom_flags(FILE_FLAG_OPEN_REPARSE_POINT);
+        }
+        let file = options
+            .open(&requirement.source_path)
+            .context("open required managed ordinary source")?;
+        anyhow::ensure!(
+            file.metadata()
+                .context("inspect opened managed ordinary source")?
+                .is_file(),
+            "opened managed ordinary source is not a regular file"
+        );
+        let mut bytes = Vec::new();
+        file.take(1_048_577)
+            .read_to_end(&mut bytes)
+            .context("read required managed ordinary source")?;
+        let declaration = validate_declaration(&requirement, &bytes)?;
+        let source_path = AbsolutePathBuf::try_from(requirement.source_path)?;
+        let make_handler = |event_name, groups: &[OrdinaryGroup], display_order| {
+            let handler = groups
+                .first()
+                .and_then(|group| group.hooks.first())
+                .context("managed ordinary declaration lost its validated handler")?;
+            Ok::<_, anyhow::Error>(ConfiguredHandler {
+                builtin: false,
+                event_name,
+                matcher: None,
+                timeout_sec: handler.timeout,
+                status_message: None,
+                // The strict 64 KiB response bound already admits this private context.
+                // Preserve it in full instead of applying the native token preview.
+                additional_context_limit: AdditionalContextLimit::from_config(Some(0)),
+                source_path: source_path.clone().into(),
+                source: HookSource::SessionFlags,
+                display_order,
+                kind: ConfiguredHandlerKind::Command {
+                    command: handler.command.clone(),
+                    env: Default::default(),
+                    r#async: false,
+                },
+            })
+        };
+        Ok(Self {
+            submit: make_handler(
+                HookEventName::UserPromptSubmit,
+                &declaration.hooks.submit,
+                0,
+            )?,
+            stop: make_handler(HookEventName::Stop, &declaration.hooks.stop, 1)?,
+        })
+    }
